{
  "name": "stellar-micro-donation-api",
  "version": "1.0.0",
  "description": "Micro-donation API using Stellar blockchain",
  "license": "MIT",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run validate-env && node src/app.js",
    "validate-env": "node src/utils/startupChecks.js",
    "predeploy:check": "node src/utils/startupChecks.js && node scripts/validate-env.js",
    "check": "node src/utils/startupChecks.js",
    "init-db": "node src/scripts/initDB.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:rollback": "node src/scripts/migrate-rollback.js",
    "migrate:status": "node src/scripts/migrate-status.js",
    "migrate:check": "node scripts/check-migration-ids.js",
    "test:migrations": "node scripts/test-migrations.js",
    "migrate:memo": "node src/scripts/addMemoColumn.js",
    "migrate:reencrypt": "node src/scripts/reencrypt-memos.js",
    "migrate:currency": "node src/scripts/migrations/addCurrencyColumns.js",
    "test": "jest",
    "test:chaos": "jest tests/chaos --runInBand",
    "test:e2e": "jest --config jest.config.e2e.js",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --coverage --ci --maxWorkers=2 --json --outputFile=coverage/jest-results.json",
    "check-coverage": "node scripts/check-coverage.js",
    "lint": "eslint . --cache --max-warnings=440",
    "lint:security": "eslint . --ext .js --format stylish",
    "typecheck": "tsc --noEmit",
    "security:scan": "node src/scripts/security-scan.js",
    "keys": "node src/scripts/manageApiKeys.js",
    "keys:create": "node src/scripts/manageApiKeys.js create",
    "keys:list": "node src/scripts/manageApiKeys.js list",
    "keys:help": "node src/scripts/manageApiKeys.js help",
    "generate-key": "node src/scripts/generateKey.js",
    "rotate-kek": "node src/scripts/rotateKEK.js",
    "validate:rbac": "node scripts/validate-rbac.js",
    "openapi:generate": "node scripts/generate-openapi.js",
    "openapi:check": "node scripts/check-openapi-sync.js && node scripts/verify-route-coverage.js",
    "examples:generate-keys": "node scripts/generate-example-keys.js",
    "examples:validate": "node scripts/validate-examples.js",
    "test:load": "node tests/load/run-load-tests.js",
    "test:load:jest": "jest tests/implement-load-testing-suite.test.js --testTimeout=60000",
    "test:smoke": "jest --config jest.config.smoke.js",
    "test:quarantine": "jest --config jest.config.quarantine.js",
    "test:backup-restore": "node scripts/test-backup-restore.js",
    "mutation:test": "node scripts/run-mutation-tests.js",
    "mutation:watch": "node scripts/run-mutation-tests.js --watch",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:write": "node scripts/generate-changelog.js --write",
    "changelog:check": "node scripts/check-changelog-sync.js",
    "check:no-json-persistence": "node scripts/check-no-json-persistence.js",
    "check:test-naming": "node scripts/check-test-naming.js",
    "check:i18n-orphans": "node scripts/check-i18n-orphans.js",
    "check:no-float-money": "node scripts/check-no-float-money.js",
    "check:declared-deps": "node scripts/check-declared-deps.js",
    "config:generate": "node scripts/generate-config-docs.js",
    "config:check": "node scripts/check-env-documented.js",
    "docs:error-codes": "node scripts/generate-error-codes.js",
    "scan:container": "bash scripts/scan-container.sh",
    "scan:container:all": "bash scripts/scan-container.sh --severity CRITICAL,HIGH,MEDIUM,LOW",
    "scan:container:json": "bash scripts/scan-container.sh --format json --output trivy-results.json",
    "check:isolation": "node scripts/check-test-isolation.js",
    "test:ci": "npm run check:isolation && jest --ci --maxWorkers=2"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "ajv": "^8.12.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "graphql": "^16.13.2",
    "graphql-http": "^1.23.1",
    "graphql-ws": "^6.4.1",
    "helmet": "^8.3.0",
    "maxmind": "^5.0.7",
    "multer": "^2.1.1",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-local": "file:./eslint-rules",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "sql.js": "^1.15.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
