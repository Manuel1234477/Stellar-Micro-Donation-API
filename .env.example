# =====================================
# Stellar Micro-Donation API — .env.example
#
# GENERATED FILE — do not edit by hand.
# Source: src/config/envSchema.js. Regenerate with: npm run config:generate
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variables marked REQUIRED must be set before the server will start.
# Variables marked OPTIONAL have safe defaults and can be left commented.
# Full documentation: docs/CONFIGURATION.md
# =====================================


# =====================================
# Server
# =====================================

# Base path prefix prepended to all API routes
# OPTIONAL — default: /api/v1
# API_PREFIX=/api/v1

# Unique identifier for this process instance (used for scheduler/sequence leases and
# logs). Defaults to a random UUID
# OPTIONAL
# INSTANCE_ID=

# Runtime environment: `development`, `test` or `production`. Controls logging
# verbosity, startup guards and unsafe-flag checks
# OPTIONAL — default: development
NODE_ENV=development

# TCP port the HTTP server listens on
# OPTIONAL — default: 3000
PORT=3000

# Global per-request timeout in milliseconds. Streaming endpoints are exempt
# OPTIONAL — default: 30000
# REQUEST_TIMEOUT_MS=30000

# Alias for `SHUTDOWN_TIMEOUT_MS` (milliseconds). Time allowed for in-flight requests to
# drain before force-exit
# OPTIONAL — default: 30000
# SHUTDOWN_TIMEOUT=30000

# Milliseconds to wait for graceful shutdown before force-exit
# OPTIONAL — default: 30000
# SHUTDOWN_TIMEOUT_MS=30000

# Comma-separated list of trusted proxy IPs/CIDRs. Passed to Express `trust proxy`. Set
# to the address of your load balancer in production
# OPTIONAL — default: loopback
# TRUSTED_PROXIES=loopback


# =====================================
# Authentication & API Keys
# =====================================

# Notify owners of keys that expired within this many days
# OPTIONAL — default: 1
# API_KEY_EXPIRED_WINDOW_DAYS=1

# Comma-separated days-before-expiry at which key owners are warned (e.g. `30,7,1`)
# OPTIONAL — default: 1,7,30
# API_KEY_EXPIRY_WARN_DAYS=1,7,30

# Include the `X-API-Key-Expires-In` response header for keys within this many days of
# expiry
# OPTIONAL — default: 30
# API_KEY_HEADER_WINDOW_DAYS=30

# Timeout (ms) for API-key expiry notification webhooks
# OPTIONAL — default: 10000
# API_KEY_WEBHOOK_TIMEOUT_MS=10000

# Comma-separated list of raw API keys accepted by the legacy authentication path. At
# least one key is required
# REQUIRED
API_KEYS=dev_key_1234567890,dev_key_abcdef123456

# Duration (ms) of the authentication lockout
# OPTIONAL — default: 900000
# AUTH_LOCKOUT_MS=900000

# Maximum failed authentication attempts before an IP is locked out
# OPTIONAL — default: 5
# AUTH_MAX_ATTEMPTS=5

# Rolling window (ms) in which `AUTH_MAX_ATTEMPTS` failures trigger lockout
# OPTIONAL — default: 900000
AUTH_WINDOW_MS=60000

# Stellar home domain used in SEP-10 web-auth challenges
# OPTIONAL
# HOME_DOMAIN=

# Secret used to sign and verify JWT tokens. Must satisfy [secret strength
# rules](#25-secret-strength-requirements) if set
# OPTIONAL
# JWT_SECRET=

# Absolute lifetime (days) of a refresh-token family, regardless of rotation
# OPTIONAL — default: 30
# REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30

# HMAC secret used to verify inbound request signatures
# OPTIONAL
# REQUEST_SIGNING_SECRET=

# Seconds of clock skew tolerated in signed requests
# OPTIONAL — default: 300
# REQUEST_SIGNING_WINDOW_SECONDS=300

# When `true`, admin endpoints require a valid TOTP code alongside the API key
# OPTIONAL — default: false
# REQUIRE_ADMIN_2FA=false

# When `true`, POST/PATCH/PUT requests without `X-Idempotency-Key` are rejected
# OPTIONAL — default: false
# REQUIRE_IDEMPOTENCY_KEY=false

# When `true`, every mutating request must carry a valid HMAC request signature
# OPTIONAL — default: false
# REQUIRE_REQUEST_SIGNING=false

# Seconds a SEP-10 challenge token remains valid
# OPTIONAL — default: 300
# SEP10_CHALLENGE_TTL=300

# Lifetime of signed download/export URLs in milliseconds
# OPTIONAL — default: 3600000
# SIGNED_URL_EXPIRY_MS=3600000

# Issuer label embedded in TOTP QR codes
# OPTIONAL — default: StellarDonationAPI
# TOTP_ISSUER=StellarDonationAPI

# Number of 30-second TOTP windows (±) accepted to tolerate clock skew
# OPTIONAL — default: 1
# TOTP_WINDOW=1


# =====================================
# Encryption & Secrets
# =====================================

# Secret from which anonymous donor tokens are derived. Must be distinct from
# `ENCRYPTION_KEY`
# OPTIONAL
# ANONYMOUS_DONATION_SECRET=

# KMS-wrapped `ENCRYPTION_KEY`. Unwrapped at startup when `KMS_KEY_ID` is set
# OPTIONAL
# ENCRYPTED_ENCRYPTION_KEY=

# AES-256 key used to encrypt wallet secret keys and other sensitive data at rest.
# Generate with `npm run generate-key`. Changing this key makes all previously encrypted
# data unrecoverable.
# REQUIRED in production
ENCRYPTION_KEY=<run `npm run generate-key` and paste the 64-char hex output here>

# Previous encryption key used during key rotation. Required when
# `ENCRYPTION_KEY_VERSION=1`
# OPTIONAL
# ENCRYPTION_KEY_1=

# Active encryption key version. `1` requires `ENCRYPTION_KEY_1` (the previous key) for
# rotation. Additional versions are read from `ENCRYPTION_KEY_<N>`
# OPTIONAL — default: 1
ENCRYPTION_KEY_VERSION=0

# RSA/EC private key PEM used by asymmetric signing paths
# OPTIONAL
# ENCRYPTION_PRIVATE_KEY=

# RSA/EC public key PEM used to verify asymmetric signatures
# OPTIONAL
# ENCRYPTION_PUBLIC_KEY=

# Legacy symmetric encryption secret for non-wallet data paths
# OPTIONAL
# ENCRYPTION_SECRET=

# HMAC secret for signing CSV/JSON export files. Must be distinct from `ENCRYPTION_KEY`
# OPTIONAL
# EXPORT_SIGNING_SECRET=

# HMAC secret that signs access tokens. At least 32 characters. Must be distinct from `ENCRYPTION_KEY`.
# Required when NODE_ENV is production or staging.
# Rotating ENCRYPTION_KEY does not invalidate sessions.
# JWT_SIGNING_SECRET=

# Previous JWT_SIGNING_SECRET, kept while tokens issued before a rotation are still valid
# JWT_SIGNING_SECRET_PREVIOUS=

# Memos processed per batch by the background re-encryption job
# OPTIONAL — default: 50
# MEMO_REENCRYPT_BATCH_SIZE=50

# Interval (ms) between memo re-encryption batches
# OPTIONAL — default: 30000
# MEMO_REENCRYPT_INTERVAL_MS=30000

# Target key during a live re-encryption pass (`npm run migrate:reencrypt`)
# OPTIONAL
# NEW_ENCRYPTION_KEY=

# TTL (ms) of the cached key-rotation lock state
# OPTIONAL — default: 5000
# ROTATION_LOCK_CACHE_TTL_MS=5000

# Minimum interval (ms) between "rotation in progress" warnings
# OPTIONAL — default: 60000
# ROTATION_LOCK_WARN_INTERVAL_MS=60000

# Transaction signing provider: `software`/`local` (in-process key), `hsm` or `kms`
# OPTIONAL — default: software
SIGNING_PROVIDER=local

# HMAC secret for the `stripe` inbound webhook source
# OPTIONAL
# STRIPE_WEBHOOK_SECRET=


# =====================================
# Stellar / Horizon
# =====================================

# Break-glass override that allows `NODE_ENV=production` to target testnet. Startup
# fails without it
# OPTIONAL — default: false
# ALLOW_TESTNET_IN_PRODUCTION=false

# Service-account balance (XLM) below which a warning alert is sent
# OPTIONAL — default: 10
# BALANCE_ALERT_THRESHOLD_XLM=10

# Interval (ms) between service-account balance checks
# OPTIONAL — default: 300000
# BALANCE_CHECK_INTERVAL_MS=300000

# Service-account balance (XLM) below which a critical alert is sent
# OPTIONAL — default: 2
# BALANCE_CRITICAL_THRESHOLD_XLM=2

# Interval (ms) between background confirmation threshold checks for pending
# transactions (#1606)
# OPTIONAL — default: 5000
# CONFIRMATION_CHECK_INTERVAL_MS=5000

# Deprecated alias of `CONFIRMATION_THRESHOLD`
# DEPRECATED — Use CONFIRMATION_THRESHOLD
# OPTIONAL
CONFIRMATION_LEDGER_THRESHOLD=3

# Number of ledger closings required before a transaction is considered confirmed (min:
# 1, max: 10). Backwards compatible with `CONFIRMATION_LEDGER_THRESHOLD`.
# OPTIONAL — default: 1
# CONFIRMATION_THRESHOLD=1

# Skip submitting real Stellar transactions. Useful for staging. Startup fails in
# production if `true`
# OPTIONAL — default: false
# DRY_RUN=false

# Timeout (ms) for Horizon API calls. The network-fee estimator uses 5000 ms when unset
# OPTIONAL — default: 15000
# HORIZON_API_TIMEOUT_MS=15000

# Time (ms) the circuit breaker stays open before attempting a probe request
# OPTIONAL — default: 30000
# HORIZON_CB_COOLDOWN_MS=30000

# Number of consecutive Horizon failures before the circuit breaker opens
# OPTIONAL — default: 5
# HORIZON_CB_FAILURE_THRESHOLD=5

# Rolling window (ms) in which failures are counted by the circuit breaker
# OPTIONAL — default: 60000
# HORIZON_CB_WINDOW_MS=60000

# Consecutive failures before switching to a fallback Horizon URL
# OPTIONAL — default: 3
# HORIZON_FAILOVER_THRESHOLD=3

# Comma-separated fallback Horizon URLs used when the primary is unhealthy
# OPTIONAL
# HORIZON_FALLBACK_URLS=

# Maximum number of automatic retries for failed Horizon requests
# OPTIONAL — default: 3
# HORIZON_MAX_RETRY_ATTEMPTS=3

# Minimum cooldown (ms) between using the same pool connection
# OPTIONAL — default: 30000
# HORIZON_POOL_COOLDOWN_MS=30000

# Number of parallel Horizon HTTP connections maintained per pool
# OPTIONAL — default: 3
HORIZON_POOL_SIZE=5

# Time (ms) before retrying the primary Horizon URL after failover
# OPTIONAL — default: 60000
# HORIZON_RECOVERY_COOLDOWN_MS=60000

# Base delay (ms) for Horizon retry exponential back-off
# OPTIONAL — default: 200
# HORIZON_RETRY_BASE_DELAY_MS=200

# Maximum delay (ms) cap for Horizon retry back-off
# OPTIONAL — default: 2000
# HORIZON_RETRY_MAX_DELAY_MS=2000

# Timeout (ms) for Horizon SSE stream connections
# OPTIONAL — default: 60000
# HORIZON_STREAM_TIMEOUT_MS=60000

# Timeout (ms) for transaction submission to Horizon
# OPTIONAL — default: 30000
# HORIZON_SUBMIT_TIMEOUT_MS=30000

# Override the Horizon endpoint URL. Defaults to the canonical URL for `STELLAR_NETWORK`
# OPTIONAL
HORIZON_URL=https://horizon-testnet.stellar.org

# Minimum XLM balance (in XLM) required in a wallet for operations
# OPTIONAL — default: 1
# MIN_RESERVE_XLM=1

# When `true`, no outbound Stellar/Horizon calls are made. Required for local dev and CI
# OPTIONAL — default: false
MOCK_STELLAR=true

# Artificial delay (ms) injected by the mock Stellar service to simulate network latency
# OPTIONAL — default: 0
# MOCK_STELLAR_LATENCY_MS=0

# JSON-encoded map of recipient IDs to Stellar secret keys for multi-recipient flows
# OPTIONAL
# RECIPIENT_SECRETS=

# Public key of the service account monitored for low balance
# OPTIONAL
SERVICE_ACCOUNT_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar secret key (`S…`) for service-initiated signing operations. Never commit.
# OPTIONAL
# SERVICE_SECRET_KEY=

# Alias for `SERVICE_SECRET_KEY` used in some signing paths
# OPTIONAL
# SERVICE_SIGNING_KEY=

# Mock Stellar only: set `false` to disable transaction simulation
# OPTIONAL — default: true
# SIMULATION_ENABLED=true

# Soroban RPC endpoint for smart-contract calls
# OPTIONAL
# SOROBAN_RPC_URL=

# Stellar secret key of the fee-bump sponsor account
# OPTIONAL
# SPONSOR_SECRET=

# Override the base reserve (XLM) of the active Stellar environment preset (preset: 0.5)
# OPTIONAL
# STELLAR_BASE_RESERVE=

# Alias for `STELLAR_NETWORK` accepted by some service modules
# OPTIONAL — default: testnet
# STELLAR_ENVIRONMENT=testnet

# Base URL of the Stellar block explorer used to build transaction links
# OPTIONAL
# STELLAR_EXPLORER_URL=

# Override the fee multiplier of the active Stellar environment preset (preset: 100)
# OPTIONAL
STELLAR_FEE_MULTIPLIER=1

# Target Stellar network. Allowed: `testnet`, `mainnet`, `futurenet`
# DEPRECATED — Use STELLAR_ENVIRONMENT
# OPTIONAL — default: testnet
STELLAR_NETWORK=testnet

# Override the network passphrase. Inferred from `STELLAR_NETWORK` when omitted
# OPTIONAL
# STELLAR_NETWORK_PASSPHRASE=

# Legacy alias for the Stellar signing secret in older code paths
# OPTIONAL
# STELLAR_SECRET=

# Maximum number of Horizon history pages fetched during a transaction sync pass
# OPTIONAL — default: 100
# SYNC_MAX_PAGES=100

# Interval (ms) between automatic transaction reconciliation runs
# OPTIONAL — default: 900000
TX_SYNC_INTERVAL_MS=30000

# Sync lease length as a multiple of `TX_SYNC_INTERVAL_MS`
# OPTIONAL — default: 2
# TX_SYNC_LEASE_MULTIPLIER=2

# Alias for `MOCK_STELLAR` in some service modules
# OPTIONAL — default: false
# USE_MOCK_STELLAR=false


# =====================================
# Database
# =====================================

# Number of days to retain audit log entries before they are purged
# OPTIONAL — default: 90
# AUDIT_LOG_RETENTION_DAYS=90

# Milliseconds to wait for an available pool connection before failing
# OPTIONAL — default: 10000
# DB_ACQUIRE_TIMEOUT=10000

# File path to the SQLite database (relative to project root)
# OPTIONAL — default: ./donations.db
DB_PATH=./data/stellar_donations.db

# Maximum number of concurrent SQLite connections
# OPTIONAL — default: 10
# DB_POOL_MAX=10

# Minimum number of idle connections kept in the SQLite pool
# OPTIONAL — default: 1
# DB_POOL_MIN=1

# Alias for `DB_POOL_MAX`. Maximum number of concurrent SQLite connections
# OPTIONAL — default: 5
# DB_POOL_SIZE=5

# Timeout (ms) applied to individual SQL queries
# OPTIONAL — default: 5000
# DB_QUERY_TIMEOUT_MS=5000

# Database driver. Currently only `sqlite` is supported
# OPTIONAL — default: sqlite
# DB_TYPE=sqlite

# Polling interval (ms) when waiting for the migration lock
# OPTIONAL — default: 500
# MIGRATION_LOCK_POLL_INTERVAL_MS=500

# Milliseconds to wait for the advisory migration lock before failing
# OPTIONAL — default: 30000
# MIGRATION_LOCK_TIMEOUT_MS=30000

# Days before audit-log rows are deleted by the retention job
# OPTIONAL — default: 365
# RETENTION_AUDIT_LOGS_DAYS=365

# Days before donation rows are eligible for retention purge
# OPTIONAL — default: 2555
# RETENTION_DONATIONS_DAYS=2555

# When `true`, the retention job logs what it would delete without removing records
# OPTIONAL — default: false
# RETENTION_DRY_RUN=false

# Days before idempotency keys are purged
# OPTIONAL — default: 30
# RETENTION_IDEMPOTENCY_DAYS=30

# Cron expression controlling when the data-retention cleanup job runs
# OPTIONAL — default: 02:00
RETENTION_SCHEDULE_CRON=0 2 * * *

# Number of slow-query records retained in memory for the diagnostics endpoint
# OPTIONAL — default: 100
# SLOW_QUERY_BUFFER_SIZE=100

# Queries exceeding this threshold (ms) are logged as slow
# OPTIONAL — default: 100
SLOW_QUERY_THRESHOLD_MS=1000


# =====================================
# CORS
# =====================================

# Allow every origin. Startup fails in production if `true`
# OPTIONAL — default: false
# CORS_ALLOW_ALL=false

# Comma-separated request headers allowed through CORS
# OPTIONAL — default: Content-Type,Authorization,X-API-Key,X-Request-ID,X-Idempotency-Key
# CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key,X-Request-ID,X-Idempotency-Key

# Comma-separated HTTP methods allowed in CORS pre-flight responses
# OPTIONAL — default: GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Comma-separated list of allowed browser origins. In production, set this explicitly —
# omitting it rejects all browser origins
# OPTIONAL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# `Access-Control-Max-Age` value in seconds (how long browsers may cache pre-flight
# results)
# OPTIONAL — default: 86400
# CORS_MAX_AGE=86400


# =====================================
# Logging
# =====================================

# When `true`, health-check requests appear in the access log
# OPTIONAL — default: false
# ACCESS_LOG_INCLUDE_HEALTH=false

# Interval (ms) at which buffered audit-log entries are flushed to the database
# OPTIONAL — default: 1000
# AUDIT_LOG_FLUSH_INTERVAL_MS=1000

# Enable verbose debug logging. Startup fails in production if `true`
# OPTIONAL — default: false
DEBUG_MODE=false

# Log raw request and response bodies
# OPTIONAL — default: false
# LOG_BODY=false

# Comma-separated path prefixes for which request bodies are logged (overrides
# `LOG_BODY`)
# OPTIONAL
# LOG_BODY_PATHS=

# Directory for log files when `LOG_TO_FILE=true`
# OPTIONAL — default: ./logs
LOG_DIR=./logs

# Log output format: `json` or `pretty`
# Allowed: json, text
# OPTIONAL — default: text
LOG_FORMAT=json

# Include request headers in access log entries
# OPTIONAL — default: false
# LOG_HEADERS=false

# Minimum log level: `debug`, `info`, `warn` or `error`
# OPTIONAL — default: info
# LOG_LEVEL=info

# Number of rotated log files to retain
# OPTIONAL — default: 10
# LOG_MAX_BACKUPS=10

# Maximum log file size in bytes before rotation
# OPTIONAL — default: 52428800
# LOG_MAX_SIZE=52428800

# Fraction of requests to log (0–1). `1` logs every request
# OPTIONAL — default: 1
# LOG_SAMPLE_RATE=1

# Comma-separated paths excluded from access log output
# OPTIONAL
# LOG_SKIP_PATHS=

# Write logs to rotating files in addition to stdout
# OPTIONAL — default: false
LOG_TO_FILE=false

# Include request/response bodies in console log output
# OPTIONAL — default: false
LOG_VERBOSE=false


# =====================================
# Rate Limiting
# =====================================

# Maximum requests per minute per IP on `POST /auth/refresh`
# OPTIONAL — default: 20
AUTH_REFRESH_RATE_LIMIT=20

# Maximum requests per minute per IP on `POST /auth/token`
# OPTIONAL — default: 10
AUTH_TOKEN_RATE_LIMIT=10

# Disables rate limiting. Unsafe — startup fails in production if `true`
# OPTIONAL — default: false
# DISABLE_RATE_LIMIT=false

# Maximum requests per IP per rate-limit window (global limiter)
# OPTIONAL — default: 100
RATE_LIMIT=100

# Interval (ms) between in-memory store cleanup passes that evict expired windows
# OPTIONAL — default: 60000
# RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# When `RATE_LIMIT_STORE=redis`, controls behaviour on Redis unavailability. `true` =
# allow requests; `false` = deny requests
# OPTIONAL — default: true
# RATE_LIMIT_FAIL_OPEN=true

# Alias for `RATE_LIMIT` used in some middleware
# OPTIONAL — default: 100
# RATE_LIMIT_MAX_REQUESTS=100

# Backing store for rate-limit counters: `memory` or `redis`. Use `redis` in
# multi-instance deployments
# Allowed: memory, redis
# OPTIONAL — default: memory
# RATE_LIMIT_STORE=memory

# Rolling window duration (ms) for the global rate limiter
# OPTIONAL — default: 60000
# RATE_LIMIT_WINDOW_MS=60000

# Redis connection URL (e.g. `redis://localhost:6379`). Required when
# `RATE_LIMIT_STORE=redis`
# OPTIONAL
# REDIS_URL=


# =====================================
# Donation Limits & Business Logic
# =====================================

# Number of donations processed in parallel during a batch submission
# OPTIONAL — default: 5
# BULK_DONATION_CONCURRENCY=5

# Default database chunk size for bulk wallet imports
# OPTIONAL — default: 50
# BULK_IMPORT_BATCH_SIZE=50

# Maximum number of rows accepted per bulk wallet-import request
# OPTIONAL — default: 1000
# BULK_IMPORT_MAX_ROWS=1000

# Maximum size (bytes) of a bulk import payload
# OPTIONAL — default: 1048576
# BULK_IMPORT_MAX_SIZE_BYTES=1048576

# Number of days after which a donation can no longer be disputed
# OPTIONAL — default: 30
# DISPUTE_WINDOW_DAYS=30

# Interval (ms) of the worker that expires stale multi-signer donation approvals
# OPTIONAL — default: 300000
# DONATION_APPROVAL_EXPIRY_INTERVAL_MS=300000

# Rows fetched per batch when generating donation exports
# OPTIONAL — default: 500
# EXPORT_BATCH_SIZE=500

# Daily XLM cap per donor. `0` disables the cap
# OPTIONAL — default: 0
MAX_DAILY_DONATION_PER_DONOR=0

# Maximum accepted donation amount in XLM
# OPTIONAL — default: 10000
MAX_DONATION_AMOUNT=10000

# Maximum platform fee cap in XLM regardless of `PLATFORM_FEE_PERCENT`
# OPTIONAL — default: 10
MAXIMUM_FEE_XLM=0.1

# Minimum accepted donation amount in XLM
# OPTIONAL — default: 0.01
MIN_DONATION_AMOUNT=0.01

# Minimum platform fee in XLM regardless of `PLATFORM_FEE_PERCENT`
# OPTIONAL — default: 0.01
# MINIMUM_FEE_XLM=0.01

# How long (ms) a pending multi-signer approval stays open
# OPTIONAL — default: 259200000
# MULTISIG_APPROVAL_WINDOW_MS=259200000

# Approvals required for donations above `MULTISIG_THRESHOLD_XLM`
# OPTIONAL — default: 2
# MULTISIG_REQUIRED_APPROVALS=2

# Donations above this amount (XLM) require multi-signer approval. Unset disables the
# workflow. Must be below `MAX_DONATION_AMOUNT`
# OPTIONAL
# MULTISIG_THRESHOLD_XLM=

# Overpayment (XLM) tolerated before a donation is flagged as overpaid
# OPTIONAL — default: 0.01
# OVERPAYMENT_TOLERANCE_XLM=0.01

# Platform fee percentage deducted from each donation (0–100)
# OPTIONAL — default: 1.5
PLATFORM_FEE_PERCENT=0

# Interval (ms) between pledge expiry check runs
# OPTIONAL — default: 60000
# PLEDGE_EXPIRY_INTERVAL_MS=60000

# TTL (seconds) for the recent-donations response cache
# OPTIONAL — default: 5
# RECENT_DONATIONS_CACHE_TTL_SECONDS=5

# Maximum number of records returned by the recent-donations endpoint
# OPTIONAL — default: 100
# RECENT_DONATIONS_MAX_LIMIT=100

# Days within which a donation is eligible for refund consideration
# OPTIONAL — default: 30
# REFUND_ELIGIBILITY_WINDOW_DAYS=30

# Hours after a donation during which a refund can be initiated
# OPTIONAL — default: 24
# REFUND_WINDOW_HOURS=24

# Lease TTL (ms) for the recurring-donation scheduler lock (one scheduler per cluster)
# OPTIONAL — default: 90000
# SCHEDULER_LOCK_TTL_MS=90000

# Donations per `VELOCITY_WINDOW_SECONDS` allowed for free-tier keys
# OPTIONAL — default: 5
# VELOCITY_LIMIT_FREE=5

# Donations per window allowed for premium-tier keys
# OPTIONAL — default: 100
# VELOCITY_LIMIT_PREMIUM=100

# Donations per window allowed for standard-tier keys
# OPTIONAL — default: 20
# VELOCITY_LIMIT_STANDARD=20

# Window (seconds) for donation velocity limits
# OPTIONAL — default: 3600
# VELOCITY_WINDOW_SECONDS=3600


# =====================================
# Caching
# =====================================

# TTL (seconds) for the in-memory API key lookup cache
# OPTIONAL — default: 60
# API_KEY_CACHE_TTL_SECONDS=60

# Interval (ms) between cache eviction passes
# OPTIONAL — default: 60000
# CACHE_CLEANUP_INTERVAL_MS=60000

# Maximum number of entries in the shared in-memory LRU cache
# OPTIONAL — default: 10000
CACHE_MAX_SIZE=1000

# Interval (ms) between federation cache cleanup passes
# OPTIONAL — default: 300000
# FEDERATION_CACHE_CLEANUP_INTERVAL_MS=300000

# Maximum number of cached federation records
# OPTIONAL — default: 5000
# FEDERATION_CACHE_MAX_SIZE=5000

# TTL (seconds) for Stellar federation record lookups
# OPTIONAL — default: 300
# FEDERATION_CACHE_TTL=300

# TTL (seconds) of the leaderboard stats cache
# OPTIONAL — default: 60
# LEADERBOARD_CACHE_TTL_SECONDS=60

# TTL (seconds) for the donation stats cache
# OPTIONAL — default: 60
# STATS_CACHE_TTL_SECONDS=60

# TTL (seconds) for the donation stats-summary cache
# OPTIONAL — default: 60
# STATS_SUMMARY_CACHE_TTL_SECONDS=60

# TTL (seconds) for cached wallet-balance responses
# OPTIONAL — default: 30
# WALLET_BALANCE_CACHE_TTL_SECONDS=30


# =====================================
# SMTP / Email Receipts
# =====================================

# Recipient address for service-account low-balance alert emails
# OPTIONAL
# ADMIN_ALERT_EMAIL=

# Recipient for export-ready notification emails when the job has no email. Falls back
# to `SMTP_TO`
# OPTIONAL
# NOTIFICATION_EMAIL=

# Sender address for outbound emails. Must be verified with your SMTP provider
# OPTIONAL
# SMTP_FROM=

# SMTP relay hostname (e.g. `smtp-relay.brevo.com`)
# OPTIONAL
SMTP_HOST=smtp-relay.brevo.com

# SMTP authentication password (alias: `SMTP_PASSWORD`)
# OPTIONAL
# SMTP_PASS=

# Alias for `SMTP_PASS`
# OPTIONAL
# SMTP_PASSWORD=

# SMTP port
# OPTIONAL — default: 587
# SMTP_PORT=587

# Use TLS (`true`) or STARTTLS (`false`) for SMTP connections
# OPTIONAL — default: false
# SMTP_SECURE=false

# Fallback recipient for export notifications
# OPTIONAL
# SMTP_TO=

# SMTP authentication username
# OPTIONAL
# SMTP_USER=


# =====================================
# IPFS / Pinata
# =====================================

# Public IPFS gateway base URL used to construct certificate links
# OPTIONAL — default: https://gateway.pinata.cloud/ipfs
# IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Pinata API key for pinning donation impact certificates to IPFS
# OPTIONAL
# PINATA_API_KEY=

# Pinata API secret corresponding to `PINATA_API_KEY`
# OPTIONAL
# PINATA_SECRET_KEY=


# =====================================
# Geographic Blocking
# =====================================

# Country codes that are always allowed, overriding `GEO_BLOCKED_COUNTRIES`
# OPTIONAL
# GEO_ALLOWED_COUNTRIES=

# Comma-separated IPs or CIDR ranges that bypass geo-blocking
# OPTIONAL
# GEO_ALLOWED_IPS=

# Comma-separated ISO 3166-1 alpha-2 country codes whose requests are blocked (e.g.
# `RU,IR,KP`)
# OPTIONAL
# GEO_BLOCKED_COUNTRIES=

# When the GeoIP database is unavailable or a lookup fails, block () or allow () the
# request
# OPTIONAL — default: true
# GEO_STRICT_MODE=true

# Path to the MaxMind GeoLite2-Country binary database file
# OPTIONAL — default: ./data/GeoLite2-Country.mmdb
# MAXMIND_DB_PATH=./data/GeoLite2-Country.mmdb


# =====================================
# Abuse Detection
# =====================================

# Anomaly score (0–1) above which a request pattern is flagged as anomalous
# OPTIONAL — default: 0.8
# ABUSE_ANOMALY_THRESHOLD=0.8

# Duration (ms) a flagged IP remains in the suspicious list
# OPTIONAL — default: 86400000
ABUSE_BLOCK_DURATION_MS=3600000

# Optional path to a persistent SQLite file for abuse-detection tracking. If unset,
# tracking is in-memory only
# OPTIONAL
# ABUSE_DB_PATH=

# Number of repeated suspicious patterns that triggers the pattern-detection signal
# OPTIONAL — default: 5
# ABUSE_PATTERN_THRESHOLD=5

# Number of requests within `ABUSE_WINDOW_MS` that triggers the burst-detection signal
# OPTIONAL — default: 10
ABUSE_SUSPICIOUS_THRESHOLD=100

# Requests within `ABUSE_VELOCITY_WINDOW_MS` that trigger the velocity signal
# OPTIONAL — default: 30
# ABUSE_VELOCITY_THRESHOLD=30

# Rolling window (ms) for the velocity signal
# OPTIONAL — default: 60000
# ABUSE_VELOCITY_WINDOW_MS=60000

# Rolling window (ms) in which request counts are tracked for burst detection
# OPTIONAL — default: 3600000
ABUSE_WINDOW_MS=60000


# =====================================
# Replay & Deduplication
# =====================================

# Window (seconds) in which identical mutating requests without an Idempotency-Key are
# deduplicated by body hash
# OPTIONAL — default: 60
# BODY_DEDUP_WINDOW_SECONDS=60

# Window (ms) in which duplicate memo values are considered collisions
# OPTIONAL — default: 300000
# MEMO_COLLISION_WINDOW_MS=300000

# Directory where memo encryption keys are persisted
# OPTIONAL — default: ./data/memo-keys
# MEMO_KEYS_DIR=./data/memo-keys

# Interval (ms) between nonce-store cleanup passes
# OPTIONAL — default: 300000
# NONCE_CLEANUP_INTERVAL_MS=300000

# Maximum number of nonce entries held in memory
# OPTIONAL — default: 100000
# NONCE_MAX_SIZE=100000

# Interval (seconds) between replay-store cleanup passes
# OPTIONAL — default: 60
# REPLAY_CLEANUP_INTERVAL_SECONDS=60

# Timeout (ms) for the replay-detection store lookup
# OPTIONAL — default: 200
# REPLAY_DETECTION_TIMEOUT_MS=200

# Number of duplicate signatures allowed before rejection
# OPTIONAL — default: 3
# REPLAY_THRESHOLD=3

# Window (seconds) within which a duplicate request signature is rejected
# OPTIONAL — default: 60
REPLAY_WINDOW_SECONDS=300


# =====================================
# Backup
# =====================================

# AWS region used for S3 backup uploads (and KMS if applicable)
# OPTIONAL — default: us-east-1
# AWS_REGION=us-east-1

# Local directory where encrypted database backup files are written
# OPTIONAL — default: ./data/backups
# BACKUP_DIR=./data/backups

# Interval (ms) between automatic backup runs
# OPTIONAL — default: 86400000
BACKUP_INTERVAL_MS=3600000

# S3 bucket name for off-site backup upload. When unset, backups are local only
# OPTIONAL
# BACKUP_S3_BUCKET=

# Key prefix used when uploading backup files to S3
# OPTIONAL — default: backups/
# BACKUP_S3_PREFIX=backups/


# =====================================
# SSE / WebSocket Streaming
# =====================================

# Enable server-sent event (SSE) and WebSocket push endpoints
# OPTIONAL — default: false
# ENABLE_SERVER_PUSH=false

# Interval (ms) between keepalive comments on the leaderboard SSE stream
# OPTIONAL — default: 15000
# LEADERBOARD_KEEPALIVE_MS=15000

# Pub/sub adapter: `memory` (in-process) or `redis`
# Allowed: memory, redis
# OPTIONAL — default: memory
# PUBSUB_ADAPTER=memory

# Number of events buffered per SSE connection for reconnecting clients
# OPTIONAL — default: 100
# SSE_EVENT_BUFFER_SIZE=100

# Maximum concurrent SSE streams per API key. Enforced cluster-wide when
# `SHARED_STATE_BACKEND=redis`
# OPTIONAL — default: 5
SSE_MAX_CONNECTIONS_PER_KEY=10

# Interval (ms) between WebSocket ping frames
# OPTIONAL — default: 30000
# WS_HEARTBEAT_MS=30000

# Maximum number of wallet subscriptions per WebSocket connection
# OPTIONAL — default: 50
# WS_MAX_WALLETS=50


# =====================================
# Observability & Tracing
# =====================================

# URL to POST anomaly-detection alerts to. When unset, alerts are logged only
# OPTIONAL
# ANOMALY_WEBHOOK_URL=

# Number of orphaned transactions before an alert is triggered
# OPTIONAL — default: 1
# ORPHAN_ALERT_THRESHOLD=1

# Enable OpenTelemetry tracing. Set `false` to disable
# OPTIONAL — default: true
OTEL_ENABLED=false

# OTLP exporter endpoint URL (e.g. `http://collector:4318`)
# OPTIONAL
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318

# Comma-separated `key=value` pairs added as headers to OTLP export requests
# OPTIONAL
# OTEL_EXPORTER_OTLP_HEADERS=

# Service name reported to the OTLP collector
# OPTIONAL — default: stellar-donation-api
# OTEL_SERVICE_NAME=stellar-donation-api


# =====================================
# Organisation Metadata
# =====================================

# Street address printed on tax receipts
# OPTIONAL
# ORGANIZATION_ADDRESS=

# City component of the organisation's mailing address
# OPTIONAL
# ORGANIZATION_CITY=

# Employer Identification Number (EIN) printed on tax receipts
# OPTIONAL
# ORGANIZATION_EIN=

# Contact email address printed on receipts
# OPTIONAL
# ORGANIZATION_EMAIL=

# Legal name of the organisation for receipt headers
# OPTIONAL
# ORGANIZATION_LEGAL_NAME=

# Contact phone number printed on receipts
# OPTIONAL
# ORGANIZATION_PHONE=

# State/province component of the organisation's mailing address
# OPTIONAL
# ORGANIZATION_STATE=

# Website URL printed on receipts
# OPTIONAL
# ORGANIZATION_WEBSITE=

# Postal code component of the organisation's mailing address
# OPTIONAL
# ORGANIZATION_ZIP_CODE=


# =====================================
# Signing Providers (HSM / KMS)
# =====================================

# Alias of `KMS_KEY_ID` read by the `generate-key` script
# OPTIONAL
# AWS_KMS_KEY_ID=

# PKCS#11 slot PIN when `SIGNING_PROVIDER=hsm`
# OPTIONAL
# HSM_PIN=

# PKCS#11 slot ID when `SIGNING_PROVIDER=hsm`
# OPTIONAL
# HSM_SLOT_ID=

# KMS key ARN (AWS) or resource name (GCP) for remote signing
# OPTIONAL
# KMS_KEY_ID=

# Cloud KMS provider: `aws` or `gcp`
# OPTIONAL — default: local
# KMS_PROVIDER=local


# =====================================
# Miscellaneous / Feature Config
# =====================================

# Publicly accessible base URL of this API, used in signed download links. Defaults to
# `http://localhost:$PORT`
# OPTIONAL
API_BASE_URL=http://localhost:3000

# CoinGecko API key (`CG-…` format) for XLM/fiat exchange rate lookups. Without this,
# the unauthenticated endpoint is used (stricter rate limits)
# OPTIONAL
# COINGECKO_API_KEY=

# zlib compression level (1–9) for gzip response encoding
# OPTIONAL — default: 4
# COMPRESSION_LEVEL=4

# Minimum response size (bytes) before compression is applied
# OPTIONAL — default: 1024
# COMPRESSION_THRESHOLD_BYTES=1024

# When `true`, CSP violations are reported but not enforced
# OPTIONAL — default: false
# CSP_REPORT_ONLY=false

# URI to which CSP violation reports are sent
# OPTIONAL — default: /csp-report
# CSP_REPORT_URI=/csp-report

# Mount the public `/changelog` endpoint
# OPTIONAL — default: false
# ENABLE_CHANGELOG_ENDPOINT=false

# JSON object of feature-flag overrides, e.g. `{"newDonationFlow":true}`. See
# [docs/FEATURE_FLAGS_RUNTIME.md](./FEATURE_FLAGS_RUNTIME.md)
# OPTIONAL
# FEATURE_FLAGS=

# Domain used for Stellar federation lookups
# OPTIONAL
# FEDERATION_DOMAIN=

# JSON-encoded static federation records for local development, bypassing live
# federation lookups
# OPTIONAL
# FEDERATION_RECORDS=

# Set to `break-glass` to allow webhooks with TLS verification disabled in production.
# Any other value is ignored
# OPTIONAL
WEBHOOK_ALLOW_TLS_SKIP_VERIFY=false

# Interval (ms) of the outgoing-webhook retry worker
# OPTIONAL — default: 30000
# WEBHOOK_RETRY_INTERVAL_MS=30000

# `CODE:ISSUER` of the stablecoin used for the Stellar DEX price fallback. The XLM/USD
# rate is the mid-market price of this orderbook when CoinGecko is unavailable
# OPTIONAL
XLM_USDC_ASSET=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN


# =====================================
# Shared State (Multi-Instance)
# =====================================

# JSON array of inbound webhook sources registered at boot on every instance, e.g.
# `[{"name":"stripe","secretEnv":"STRIPE_WEBHOOK_SECRET","headerName":"stripe-signature"}]`
# OPTIONAL
# INBOUND_WEBHOOK_SOURCES=

# Backend for correctness-critical state (body-hash dedup, request-signing nonces, SSE
# per-key limits). Use `redis` when running more than one replica
# Allowed: memory, redis
# OPTIONAL — default: memory
# SHARED_STATE_BACKEND=memory

# When the shared backend is unreachable, fall back to per-process state (`true`) or
# reject the request (`false`)
# OPTIONAL — default: true
# SHARED_STATE_FAIL_OPEN=true

# Prefix for every key written to the shared-state backend
# OPTIONAL — default: smd:
# SHARED_STATE_KEY_PREFIX=smd:

# Redis URL for the shared-state backend. Falls back to `REDIS_URL`
# OPTIONAL
# SHARED_STATE_REDIS_URL=


# =====================================
# GraphQL
# =====================================

# Complexity cost assigned to each list field
# OPTIONAL — default: 10
# GRAPHQL_LIST_FIELD_COST=10

# Maximum computed query complexity before a GraphQL query is rejected
# OPTIONAL — default: 1000
# GRAPHQL_MAX_COMPLEXITY=1000

# Maximum GraphQL query nesting depth
# OPTIONAL — default: 6
# GRAPHQL_MAX_DEPTH=6

# Versioned encryption keys used during rotation (`ENCRYPTION_KEY_1`, `ENCRYPTION_KEY_2`, …)
# Pattern: ^ENCRYPTION_KEY_\d+$
