{
  "info": {
    "name": "Stellar Micro-Donation API",
    "description": "Runnable collection for testing the core donation API flows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apiKey",
    "apiKey": [
      {
        "key": "value",
        "value": "{{API_KEY}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Wallet Management",
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"{{WALLET_PUBLIC_KEY}}\",\n  \"name\": \"My Donation Wallet\",\n  \"metadata\": {\n    \"region\": \"US\",\n    \"donorType\": \"individual\"\n  }\n}\n"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/wallets",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets"
              ]
            }
          }
        },
        {
          "name": "Get Wallet Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/wallets/{{WALLET_PUBLIC_KEY}}/transactions",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{WALLET_PUBLIC_KEY}}",
                "transactions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. One-Time Donations",
      "item": [
        {
          "name": "Create Donation (custodial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": 1,\n  \"receiverId\": 2,\n  \"amount\": \"50.00\",\n  \"memo\": \"Education fund donation\",\n  \"sdgCategories\": [\"04\"]\n}\n"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/donations",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "donations"
              ]
            }
          }
        },
        {
          "name": "Create Donation (non-custodial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor\": \"{{DONOR_PUBLIC_KEY}}\",\n  \"recipient\": \"{{RECIPIENT_PUBLIC_KEY}}\",\n  \"amount\": \"50.00\",\n  \"memo\": \"Education fund donation\"\n}\n"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/donations",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "donations"
              ]
            }
          }
        },
        {
          "name": "Get Recent Donations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/donations/recent?limit=10",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "donations",
                "recent"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Donation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionHash\": \"{{TRANSACTION_HASH}}\"\n}\n"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/donations/verify",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "donations",
                "verify"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Recurring Donations",
      "item": [
        {
          "name": "Create Recurring Donation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donorPublicKey\": \"{{DONOR_PUBLIC_KEY}}\",\n  \"recipientPublicKey\": \"{{RECIPIENT_PUBLIC_KEY}}\",\n  \"amount\": \"25.00\",\n  \"frequency\": \"monthly\",\n  \"startDate\": \"2026-07-01\"\n}\n"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stream/create",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stream",
                "create"
              ]
            }
          }
        },
        {
          "name": "List Recurring Donation Schedules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stream/schedules",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stream",
                "schedules"
              ]
            }
          }
        },
        {
          "name": "Cancel Recurring Donation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stream/schedules/{{SCHEDULE_ID}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stream",
                "schedules",
                "{{SCHEDULE_ID}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Statistics & Analytics",
      "item": [
        {
          "name": "Get Daily Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stats/daily",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stats",
                "daily"
              ]
            }
          }
        },
        {
          "name": "Get Weekly Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stats/weekly",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stats",
                "weekly"
              ]
            }
          }
        },
        {
          "name": "Get Summary Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stats/summary",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stats",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Get Donor Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stats/donors",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stats",
                "donors"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Server-Sent Events (SSE) Stream",
      "item": [
        {
          "name": "Subscribe to Real-Time Transaction Stream",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stream/transactions",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stream",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Subscribe to Leaderboard Updates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/stream/leaderboard",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "stream",
                "leaderboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/health",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "DONOR_PUBLIC_KEY",
      "value": "GCBT6W2QOCFDKQAQBWNGNYYGAH2LRHGTEVK5YBL6WRVQPPWJVKUNMOMS",
      "type": "string"
    },
    {
      "key": "RECIPIENT_PUBLIC_KEY",
      "value": "GCVUHGLGMHYWM6NY33LKPHMX2GHXNMPW6HCO4DLQDG25T4OWDG7JJL6Y",
      "type": "string"
    },
    {
      "key": "WALLET_PUBLIC_KEY",
      "value": "GCMXPIWRCPVM63NUOZZDHC42CQKEUDLIBS6ZM6A3VD7SJ3UE2OHI6I4T",
      "type": "string"
    },
    {
      "key": "TRANSACTION_HASH",
      "value": "tx-hash-from-verify-response",
      "type": "string"
    },
    {
      "key": "SCHEDULE_ID",
      "value": "1",
      "type": "string"
    }
  ]
}
